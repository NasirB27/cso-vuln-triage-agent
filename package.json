{
    "name": "cso-vuln-triage-agent",
    "description": "LangGraph agent that ranks hardened container images by vulnerability severity for CSO triage. Forked from ai-pdf-chatbot-langchain.",
    "private": true,
    "version": "0.0.1",
    "author": "Terry Bates",
    "license": "MIT",
    "workspaces": [
      "backend",
      "frontend"
    ],
    "scripts": {
      "build": "yarn run turbo:command build",
      "turbo:command": "yarn turbo",
      "lint": "yarn run turbo:command lint",
      "lint:fix": "yarn run turbo:command lint:fix", 
      "format": "yarn run turbo:command format",
      "format:check": "yarn run turbo:command format:check"
    },
    "devDependencies": {
      "turbo": "latest"
    }
  }